<idea-plugin>
    <id>com.aiagent.plugin</id>
    <name>offAiAgent</name>
    <vendor email="support@aiagent.dev" url="https://github.com/aiagent-plugin">offAiAgent</vendor>

    <description><![CDATA[
        <h2>AI Agent - Offline Coding Assistant</h2>
        <p>
            A fully offline AI coding agent powered by <b>Ollama</b> or <b>llama.cpp</b>.
            No internet connection required. Your code never leaves your machine.
        </p>

        <h3>Features:</h3>
        <ul>
            <li><b>Chat Interface</b>: Talk to your AI agent naturally</li>
            <li><b>Code Generation & Refactoring</b>: Agent writes and edits code files</li>
            <li><b>Project Awareness</b>: Agent reads your project structure</li>
            <li><b>100% Offline</b>: Local inference with Ollama or GGUF models</li>
            <li><b>Agentic Tools</b>: Read, write, edit, search, and list files</li>
        </ul>
    ]]></description>

    <change-notes><![CDATA[
        <b>1.0.0</b>
        <ul>
            <li>Native Ollama auto-detection and support</li>
            <li>Agentic tools: read, write, edit, list, search files</li>
            <li>Direct settings button in tool window and Tools menu</li>
        </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Tool Window -->
        <toolWindow
            id="offAiAgent"
            displayName="offAiAgent"
            anchor="right"
            factoryClass="com.aiagent.plugin.ui.AgentToolWindowFactory"
            icon="/icons/pluginIcon.svg"/>

        <!-- Settings: File -> Settings -> Tools -> offAiAgent -->
        <projectConfigurable
            groupId="tools"
            instance="com.aiagent.plugin.settings.SettingsConfigurable"
            id="com.aiagent.plugin.settings"
            displayName="offAiAgent"/>

        <applicationConfigurable
            groupId="tools"
            instance="com.aiagent.plugin.settings.SettingsConfigurable"
            id="com.aiagent.plugin.settings.app"
            displayName="offAiAgent"/>

        <!-- Persistent State -->
        <applicationService
            serviceImplementation="com.aiagent.plugin.settings.PluginSettings"/>
    </extensions>

    <actions>
        <action
            id="AIAgent.OpenWindow"
            class="com.aiagent.plugin.actions.OpenAgentAction"
            text="offAiAgent"
            description="Open the offAiAgent chat window"
            icon="/icons/pluginIcon.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt A"/>
        </action>

        <action
            id="AIAgent.OpenSettings"
            class="com.aiagent.plugin.actions.OpenSettingsAction"
            text="offAiAgent Settings..."
            description="Open offAiAgent settings configuration">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
